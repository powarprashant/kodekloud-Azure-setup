# ==============================================================================
# Windows VM Configuration (Optional Override)
# ==============================================================================

# Resource Group (Leave empty for auto-detection in KodeKloud Sandbox)
# resource_group_name = "kml_rg_main-xxxx"

# Region
# location = "eastus"

# Virtual Machine Settings
# vm_name = "vm-windows"
# vm_size = "Standard_B2s" # Standard_B2s (4GB RAM) or Standard_D2s_v3 (8GB RAM)

# Credentials
# admin_username = "azureuser"
# admin_password = "" # Leave empty to auto-generate a secure random 18-char password

# OS Image Configuration
# windows_os_publisher = "MicrosoftWindowsServer"
# windows_os_offer     = "WindowsServer"
# windows_os_sku       = "2022-datacenter-azure-edition" # or "2022-Datacenter", "2019-Datacenter"
# windows_os_version   = "latest"

# Storage
# os_disk_type    = "StandardSSD_LRS"
# os_disk_size_gb = 127

# Security (Restrict RDP / OpenSSH to your client public IP in CIDR format e.g. "203.0.113.25/32")
# rdp_allowed_cidr = "*"
