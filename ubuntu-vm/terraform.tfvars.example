# ==============================================================================
# Ubuntu VM Configuration (Optional Override)
# ==============================================================================

# Resource Group (Leave empty for auto-detection in KodeKloud Sandbox)
# resource_group_name = "kml_rg_main-xxxx"

# Region
# location = "eastus"

# Virtual Machine Settings
# vm_name = "vm-ubuntu"
# vm_size = "Standard_B2s" # Standard_B2s (2 vCPU, 4GB RAM) recommended for Docker & SonarQube

# Credentials
# admin_username = "azureuser"
# ssh_public_key = "" # Leave empty to auto-generate a secure 4096-bit RSA key pair

# Storage
# os_disk_type    = "StandardSSD_LRS"
# os_disk_size_gb = 30

# Security (Restrict SSH to your client public IP in CIDR format e.g. "203.0.113.25/32")
# ssh_allowed_cidr = "*"
